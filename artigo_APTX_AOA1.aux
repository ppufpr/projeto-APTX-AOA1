\newlabel{tab:grn}{{4}{7}{Validação das redes inferidas contra o \emph {gold standard} STRING (\(\geq 0{,}4\); 212 arestas dentre 435 pares). Métricas pontuais no limiar top-\(k\) (\(k=212\)). Melhor valor por métrica em negrito}{table.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Inferência da rede de co-regulação do painel validada contra STRING. \textbf  {(a)} Curvas ROC e \textbf  {(b)} curvas precisão-\emph  {recall} para os dois critérios de relevância; a linha tracejada indica o classificador aleatório. \textbf  {(c)} Métricas de validação no limiar top-\(k\). A correlação supera a informação mútua em todas as métricas neste regime de poucas amostras (\(M=12\)).}}{8}{figure.caption.24}\protected@file@percent }
\newlabel{fig:grn}{{4}{8}{Inferência da rede de co-regulação do painel validada contra STRING. \textbf {(a)} Curvas ROC e \textbf {(b)} curvas precisão-\emph {recall} para os dois critérios de relevância; a linha tracejada indica o classificador aleatório. \textbf {(c)} Métricas de validação no limiar top-\(k\). A correlação supera a informação mútua em todas as métricas neste regime de poucas amostras (\(M=12\))}{figure.caption.24}{}}
